# gamescope needs CAP_SYS_NICE to take realtime scheduling priority. Without
# it, frame pacing degrades under load — exactly when it matters. Package
# upgrades replace the binary and drop the capability silently, so the symptom
# is "gaming got worse and nothing changed". Reapply it on every install.
#
# Verify by hand with: getcap /usr/bin/gamescope   ->   cap_sys_nice=eip

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = gamescope

[Action]
Description = Restoring CAP_SYS_NICE on gamescope...
When = PostTransaction
Exec = /usr/bin/setcap cap_sys_nice=eip /usr/bin/gamescope
