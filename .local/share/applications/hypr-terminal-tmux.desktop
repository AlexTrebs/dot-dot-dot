[Desktop Entry]
# Keybind target so Plasma's Meta+T matches hypr/lua/binds.lua. Plasma 6 attaches
# custom shortcuts to a .desktop file (kglobalshortcutsrc [services]).
# NoDisplay: not meant for the app menu, Alacritty's own entry is there.
Name=Terminal (tmux)
Comment=Alacritty attached to the shared tmux session
TryExec=alacritty
Exec=alacritty -e /home/alextrebs/.local/bin/auto-tmux.sh
Terminal=false
Type=Application
Icon=Alacritty
Categories=System;TerminalEmulator;
NoDisplay=true
StartupNotify=false
