[Desktop Entry]
# Keybind target for the Plasma session — see hypr-terminal-tmux.desktop.
# Under Hyprland the script toggles wf-recorder; under Plasma it starts a
# Spectacle recording, which is stopped from Spectacle's own notification.
Name=Screen recording
Comment=Record a region of the screen to ~/Videos/Recordings
Exec=/home/alextrebs/.config/hypr/scripts/screen_record.sh
Terminal=false
Type=Application
Icon=spectacle
Categories=AudioVideo;Recorder;
NoDisplay=true
StartupNotify=false
