[General]
ColorScheme=HyprEarth
Name=HyprEarth
accentColorFromWallpaper=false
shadeSortColumn=true

# Palette mirrors .config/colours.css so Qt/KDE apps, the wayle bar and the
# Hyprland border gradient all resolve to the same values. Plasma never writes
# to this file, so unlike kdeglobals/kwinrc it can safely be a symlink into the
# repo. Edit here; run ./plasma_sync.sh apply to push it live.
#
#   bg #13120d  surface #1e1e2e  elevated #262638  fg #d0cfcc
#   accent #4f8a72  positive #3E867D  neutral #bfa45a  negative #9b574d

[ColorEffects:Disabled]
Color=19,18,13
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=40,52,44
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

