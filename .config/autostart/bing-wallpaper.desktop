[Desktop Entry]
# Runs the daily wallpaper under Plasma; Hyprland runs it from lua/autostart.lua.
# The script picks hyprpaper or plasma-apply-wallpaperimage itself.
# OnlyShowIn=KDE keeps it to one run per session.
Type=Application
Name=Bing daily wallpaper
Exec=/home/alextrebs/.local/bin/bing-wallpaper.sh
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
NoDisplay=true
