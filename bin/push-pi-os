#!/usr/bin/env bash
# Push the pi-os branch to GitHub. Run this AFTER adding the SSH key at
# https://github.com/settings/keys  (the key is already on your clipboard;
# re-copy it any time with:  wl-copy < ~/.ssh/id_ed25519.pub )
set -uo pipefail

REPO=~/dot-dot-dot
cd "$REPO" || { echo "no $REPO"; exit 1; }

echo "==> testing GitHub SSH auth"
out=$(ssh -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1)
echo "    $out"
if ! grep -q "successfully authenticated" <<<"$out"; then
  echo
  echo "❌ GitHub hasn't accepted the key yet."
  echo "   1. Open https://github.com/settings/keys"
  echo "   2. 'New SSH key', paste (Ctrl+Shift+V), save"
  echo "   3. Re-run: push-pi-os"
  exit 1
fi

echo "==> pushing pi-os"
git push -u origin pi-os && {
  echo
  echo "✅ pushed. Open a PR against main with:"
  echo "   https://github.com/AlexTrebs/dot-dot-dot/compare/main...pi-os"
}
